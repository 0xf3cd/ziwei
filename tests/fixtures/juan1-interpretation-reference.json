  "scope": "十八节选句；spans为原始wiki行号（1-based）及Unicode零基半开区间，连续跨行以原换行连接。required为人工核读的必要条件片段，不是第二独立来源或盘例。",
  "entries": [
    {"suffix": "wenchang-nature", "section": "問文昌星所主若何？", "kind": "nature", "concept_ids": ["concept.star.wenchang"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.wenchang-nature", "spans": [{"line": 356, "start": 3, "end": 9}], "quote": "文昌主科甲，"}]},
    {"suffix": "wenchang-jiaji", "section": "問文昌星所主若何？", "kind": "condition", "concept_ids": ["concept.star.wenchang"], "required": {"premises": ["女人", "加吉得地", "四杀冲破"], "exceptions": ["纵四杀冲破不为下贱"]}, "citations": [{"id": "citation.quanshu-juan1.wenchang-jiaji", "spans": [{"line": 356, "start": 59, "end": 86}], "quote": "女人加吉得地，衣祿充足。四殺沖破，偏房下賤，僧道宜之。"}]},
    {"suffix": "wenqu-nature", "section": "问文曲星所主若何？", "kind": "nature", "concept_ids": ["concept.star.wenqu"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.wenqu-nature", "spans": [{"line": 365, "start": 3, "end": 23}], "quote": "文曲属水，北斗第四星也，主科甲文车之宿。"}]},
    {"suffix": "wenqu-luchan", "section": "问文曲星所主若何？", "kind": "condition", "concept_ids": ["concept.star.wenqu"], "required": {"premises": ["土宫", "来缠"], "exceptions": ["禄存、化禄", "不可以为凶论"], "limits": ["不绑定化忌"]}, "citations": [{"id": "citation.quanshu-juan1.wenqu-luchan", "spans": [{"line": 365, "start": 176, "end": 202}], "quote": "忌入土宫，限临蹭蹬。若禄存、化禄来缠，不可以为凶论。"}]},
    {"suffix": "liunian-changqu", "section": "问流年昌曲若何？", "kind": "condition", "concept_ids": ["concept.liunian.changqu"], "required": {"premises": ["大小二限", "三合拱照太阳", "流年禄", "小限太岁", "俱全", "二三拱照"], "exceptions": ["巳酉", "不能耐久"], "limits": ["未穷尽", "流祿", "歌曰"], "recheck": ["奏書博士"]}, "citations": [{"id": "citation.quanshu-juan1.liunian-changqu", "spans": [{"line": 371, "start": 3, "end": 134}], "quote": "命逢流年昌曲，为科名科甲。大小二限逢之，三合拱照太阳，又照流年禄；小限太岁逢魁钺、左右、台座、日月、科权禄马三方拱照，决然高中无疑。然亦此数星俱全方为大吉，但以流年科甲为主。如命限值之，其余吉曜，若得二三拱照，亦必高中。但二星在巳酉得地，不富即贵，只是不能耐久。"}]},
    {"suffix": "zuofu-nature", "section": "问左辅所主若何？", "kind": "nature", "concept_ids": ["concept.star.zuofu"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.zuofu-nature", "spans": [{"line": 381, "start": 7, "end": 16}], "quote": "左辅帝极主宰之星，"}]},
    {"suffix": "zuofu-zifu", "section": "问左辅所主若何？", "kind": "condition", "concept_ids": ["concept.star.zuofu"], "required": {"premises": ["三合冲照", "火忌冲破"], "exceptions": ["富贵不久", "中局"], "recheck": ["火忌"]}, "citations": [{"id": "citation.quanshu-juan1.zuofu-zifu", "spans": [{"line": 381, "start": 35, "end": 91}], "quote": "紫府禄权若得三合冲照，主文武大贵。火忌冲破，虽富贵不久。僧道清闲，所以温重贤晓，旺地封赠。火忌冲破，以中局断之。"}]},
    {"suffix": "youbi-nature", "section": "问右弼所主若何？", "kind": "nature", "concept_ids": ["concept.star.youbi"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.youbi-nature", "spans": [{"line": 385, "start": 7, "end": 16}], "quote": "右弼帝极主宰之星，"}]},
    {"suffix": "youbi-zifu", "section": "问右弼所主若何？", "kind": "condition", "concept_ids": ["concept.star.youbi"], "required": {"premises": ["同垣", "羊陀火忌冲破"], "exceptions": ["下局", "女人"], "recheck": ["火忌"]}, "citations": [{"id": "citation.quanshu-juan1.youbi-zifu", "spans": [{"line": 385, "start": 24, "end": 53}], "quote": "紫府吉星同垣，财官双美，文武双全。羊陀火忌冲破，下局断之。"}]},
    {"suffix": "kuiyue-nature", "section": "问天魁天钺星所主若何？", "kind": "nature", "concept_ids": ["concept.star.tiankui", "concept.star.tianyue"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.kuiyue-nature", "spans": [{"line": 396, "start": 7, "end": 16}], "quote": "魁钺斗中司科之星，"}]},
    {"suffix": "kuiyue-xianbu", "section": "问天魁天钺星所主若何？", "kind": "condition", "concept_ids": ["concept.star.tiankui", "concept.star.tianyue"], "required": {"premises": ["限步巡逢", "年龄"], "exceptions": ["四十以后", "墓库", "不依此断"]}, "citations": [{"id": "citation.quanshu-juan1.kuiyue-xianbu", "spans": [{"line": 396, "start": 111, "end": 162}], "quote": "限步巡逢必主女子添喜，生男则俊雅，入学功名有成。生女则容貌端庄，出众超群；若四十以后逢墓库，不依此断。"}]},
    {"suffix": "lucun-nature", "section": "问禄存星所主若何？", "kind": "nature", "concept_ids": ["concept.star.lucun"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.lucun-nature", "spans": [{"line": 405, "start": 7, "end": 30}], "quote": "禄存北斗第三星，真人之宿，主人贵爵，掌人寿基。"}]},
    {"suffix": "lucun-dushou", "section": "问禄存星所主若何？", "kind": "condition", "concept_ids": ["concept.star.lucun"], "required": {"premises": ["独守命", "无吉化"], "exceptions": ["陷空", "火铃空劫"], "limits": ["年度流禄", "化禄"], "recheck": ["吉化"]}, "citations": [{"id": "citation.quanshu-juan1.lucun-dushou", "spans": [{"line": 405, "start": 97, "end": 147}], "quote": "若独守命而无吉化，乃看财奴耳。逢吉逞其权，遇恶败其迹。最嫌落于陷空不能为福，更凑火铃空劫，巧艺安身。"}]},
    {"suffix": "tianma-nature", "section": "问天马星所主若何？", "kind": "nature", "concept_ids": ["concept.star.tianma"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.tianma-nature", "spans": [{"line": 419, "start": 7, "end": 24}], "quote": "诸宫各有制化，如身命临之谓之驿马。"}]},
    {"suffix": "tianma-erxian", "section": "问天马星所主若何？", "kind": "condition", "concept_ids": ["concept.star.tianma"], "required": {"premises": ["大小二限", "禄存紫府", "流昌"], "exceptions": ["禄马交驰", "折鞭马", "俱主灾病"], "recheck": ["流昌同书用例", "是否专指年度文昌", "以上犯此数者"]}, "citations": [{"id": "citation.quanshu-juan1.tianma-erxian", "spans": [{"line": 419, "start": 24, "end": 165}], "quote": "喜禄存、紫府、昌曲，守照为吉。如大小二限临之，更遇禄存紫府，流昌必利。如与禄存同宫，谓之禄马交驰，又曰折鞭马；紫府同宫谓之扶轝马；刑杀同宫谓之负尸马；火星同宫谓之战马；日月同宫谓雌雄马；逢空亡谓之死马、亡马；居绝死谓之死马；遇陀罗谓之折足马。以上犯此数者，俱主灾病，流年值之依此断。"}]},
    {"suffix": "hualu-nature", "section": "问化禄星所主若何？", "kind": "nature", "concept_ids": ["concept.sihua.hualu"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.hualu-nature", "spans": [{"line": 423, "start": 7, "end": 14}], "quote": "禄为福德之神。"}]},
    {"suffix": "hualu-kequan", "section": "问化禄星所主若何？", "kind": "condition", "concept_ids": ["concept.sihua.hualu"], "required": {"premises": ["身命官禄", "科权相逢"], "exceptions": ["小限", "大限", "杀凑"]}, "citations": [{"id": "citation.quanshu-juan1.hualu-kequan", "spans": [{"line": 423, "start": 14, "end": 33}], "quote": "守身命官禄之位，科权相逢必作大臣之职。"}]},
    {"suffix": "huaquan-nature", "section": "问化权星所主若何？", "kind": "nature", "concept_ids": ["concept.sihua.huaquan"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.huaquan-nature", "spans": [{"line": 427, "start": 7, "end": 16}], "quote": "权星掌判生杀之神。"}]},
    {"suffix": "huaquan-kelu", "section": "问化权星所主若何？", "kind": "condition", "concept_ids": ["concept.sihua.huaquan"], "required": {"premises": ["科禄相逢", "科权相逢", "小限", "大限"], "exceptions": ["羊陀耗使劫空"], "recheck": ["耗使"]}, "citations": [{"id": "citation.quanshu-juan1.huaquan-kelu", "spans": [{"line": 427, "start": 16, "end": 83}], "quote": "守身命科禄相逢出将入相。科权相逢必定文章冠世，人皆钦仰。小限相逢，无有不吉。大限十年，必然遂志。如逢羊陀耗使劫空，听谗贻累，官灾贬谪。"}]},
    {"suffix": "huake-nature", "section": "问化科星所主若何？", "kind": "nature", "concept_ids": ["concept.sihua.huake"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.huake-nature", "spans": [{"line": 431, "start": 7, "end": 21}], "quote": "科星上界应试，主掌文墨之星。"}]},
    {"suffix": "huake-quanlu", "section": "问化科星所主若何？", "kind": "condition", "concept_ids": ["concept.sihua.huake"], "required": {"premises": ["守身命", "权禄相逢"], "exceptions": ["恶曜", "女命"], "limits": ["科星拱照冲"]}, "citations": [{"id": "citation.quanshu-juan1.huake-quanlu", "spans": [{"line": 431, "start": 21, "end": 51}], "quote": "守身命权禄相逢宰臣之贵。如逢恶曜亦为文章秀士，可作群英师范。"}]},
    {"suffix": "huaji-nature", "section": "问化忌星所主若何？", "kind": "nature", "concept_ids": ["concept.sihua.huaji"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.huaji-nature", "spans": [{"line": 435, "start": 7, "end": 14}], "quote": "忌为多管之神。"}]},
    {"suffix": "huaji-sisha", "section": "问化忌星所主若何？", "kind": "condition", "concept_ids": ["concept.sihua.huaji"], "required": {"premises": ["如会", "同宫又兼四杀共处"], "exceptions": ["单逢"], "limits": ["不将本句缩成"]}, "citations": [{"id": "citation.quanshu-juan1.huaji-sisha", "spans": [{"line": 436, "start": 0, "end": 40}], "quote": "如会紫府、昌曲、左右、科权禄，与忌同宫又兼四杀共处，即发财亦不佳，功名亦不成就。"}]},
    {"suffix": "qingyang-nature", "section": "问擎羊星所主若何？", "kind": "nature", "concept_ids": ["concept.star.qingyang"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.qingyang-nature", "spans": [{"line": 440, "start": 7, "end": 15}], "quote": "擎羊北斗之助星。"}]},
    {"suffix": "qingyang-rumiao", "section": "问擎羊星所主若何？", "kind": "condition", "concept_ids": ["concept.star.qingyang"], "required": {"premises": ["女人", "入庙加吉", "杀耗冲破"], "exceptions": ["刑克下局"], "limits": ["不忌", "化忌"]}, "citations": [{"id": "citation.quanshu-juan1.qingyang-rumiao", "spans": [{"line": 440, "start": 127, "end": 147}], "quote": "女人入庙加吉上局，杀耗冲破多主刑克下局。"}]},
    {"suffix": "tuoluo-nature", "section": "问陀罗星所主若何？", "kind": "nature", "concept_ids": ["concept.star.tuoluo"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.tuoluo-nature", "spans": [{"line": 444, "start": 7, "end": 15}], "quote": "陀罗北斗之助星。"}]},
    {"suffix": "tuoluo-rumiao", "section": "问陀罗星所主若何？", "kind": "condition", "concept_ids": ["concept.star.tuoluo"], "required": {"premises": ["辰戌丑未生人", "在庙", "不能合成只看陀罗落支"], "exceptions": ["文人不耐久", "武人横发高迁", "陷地加杀"]}, "citations": [{"id": "citation.quanshu-juan1.tuoluo-rumiao", "spans": [{"line": 444, "start": 80, "end": 130}], "quote": "辰戌丑未生人为福，在庙财官论，文人不耐久，武人横发高迁。若陷地加杀刑克招凶，二姓延生，女人刑克下贱。"}]},
    {"suffix": "yangtuo-general", "section": "羊陀二星总论", "kind": "condition", "concept_ids": ["concept.star.qingyang", "concept.star.tuoluo"], "required": {"premises": ["羊陀合论", "三宫", "三合"], "limits": ["忌不自动关联化忌"], "recheck": ["刑、忌、暗、权、耗、贪、杀"]}, "citations": [{"id": "citation.quanshu-juan1.yangtuo-general", "spans": [{"line": 448, "start": 44, "end": 77}], "quote": "怕临兄弟、田宅、父母三宫。忌三合临身命，合昌曲、左右有暗痣、眼痣。"}]},
    {"suffix": "huoxing-nature", "section": "问火星所主若何？", "kind": "nature", "concept_ids": ["concept.star.huoxing"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.huoxing-nature", "spans": [{"line": 460, "start": 3, "end": 12}], "quote": "火星乃南斗浮星也。"}]},
    {"suffix": "huoxing-tanlang", "section": "问火星所主若何？", "kind": "condition", "concept_ids": ["concept.star.huoxing"], "required": {"premises": ["贪狼会", "旺地", "三方无杀破"], "exceptions": ["中年后始兴"], "recheck": ["跨行"]}, "citations": [{"id": "citation.quanshu-juan1.huoxing-tanlang", "spans": [{"line": 466, "start": 13, "end": 37}, {"line": 467, "start": 0, "end": 13}], "quote": "若得贪狼会，旺地贵无伦，封侯居上将，勋业着边庭，\n\t三方无杀破，中年后始兴，"}]},
    {"suffix": "lingxing-nature", "section": "问铃星所主若何？", "kind": "nature", "concept_ids": ["concept.star.lingxing"], "required": {}, "citations": [{"id": "citation.quanshu-juan1.lingxing-nature", "spans": [{"line": 472, "start": 3, "end": 12}], "quote": "铃星乃南斗助星也。"}]},
    {"suffix": "lingxing-tanlang", "section": "问铃星所主若何？", "kind": "condition", "concept_ids": ["concept.star.lingxing"], "required": {"premises": ["前后两段", "庙陷", "旺地"], "exceptions": ["羊陀", "贪狼不宁"], "limits": ["两个不连续段", "未用旺地解释消除"]}, "citations": [{"id": "citation.quanshu-juan1.lingxing-tanlang", "spans": [{"line": 477, "start": 1, "end": 37}], "quote": "若与贪狼会，指日立边庭，庙地财官贵，陷地主孤贫，羊陀若凑合，其刑大不清，"}, {"id": "citation.quanshu-juan1.lingxing-tanlang-buning", "spans": [{"line": 480, "start": 25, "end": 37}, {"line": 481, "start": 0, "end": 13}], "quote": "或遇贪狼宿，官禄亦不宁，\n\t若逢居旺地，富贵不可论。"}]},
    {"suffix": "yangtuohuoling-general", "section": "羊陀火铃四星总论", "kind": "condition", "concept_ids": ["concept.star.qingyang", "concept.star.tuoluo", "concept.star.huoxing", "concept.star.lingxing"], "required": {"premises": ["四星总论", "武曲并贪狼", "疾厄若逢之"], "exceptions": ["山寺僧", "金谷"], "limits": ["是否须同时出现未裁"]}, "citations": [{"id": "citation.quanshu-juan1.yangtuohuoling-general", "spans": [{"line": 489, "start": 1, "end": 37}], "quote": "武曲并贪狼，一世招凶恶，疾厄若逢之，四时不离着，只宜山寺僧，金谷常安乐。"}]}
  ]
}
